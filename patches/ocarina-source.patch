+            CC_SHA256_Update(&ctx, buf, (CC_LONG)r);
+            if (pwrite(out, buf, (size_t)r, (off_t)(i * part + at)) != r) { bad = 1; fprintf(stderr, "[RED] boot: write failed (errno=%d)\n", errno); break; }
+            at += (unsigned long long)r;
+        }
+        if (in >= 0) close(in);
