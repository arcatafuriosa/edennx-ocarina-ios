+# and presentation follow the same vsync interval. Adapted from OcarinaNX 2de238f.
+from nso_asm import ADRP, B
+
+# Platform workaround: the NDVE tensor network costs 65-94 ms per movie frame
+# on the iPhone. Select the engine's existing plain movie player, which keeps
+# the decoded 1920x1080 video and omits only the neural enhancement stage.
+# Original bytes and module build ID are checked by the rewriter.
+CUTS = {
+    'e0f3ccfaf50065ae4ea01eb5aeb13b1a': [
+        (0x3b5f524, '28010034', '09000014', 'movie player: use the decoded video without the NDVE tensor network'),
+    ],
+}
+
+# v131072 main: the frame step (patch_nso.py "Frame step in whole vsyncs"). The game has its own frame-rate controller (main+0x3b4ef60, called once a frame with x20 = its
+# config): from the measured frame time it picks a vsync interval between config +0x0 and +0x4 (with hysteresis, +0x50 / +0x54), stores it at +0x48 and fps = 60 / interval
+# at +0x58, then at main+0x3b4f074 (where its paths meet) calls main+0x3b4f160, which hands +0x58 to setFrameRate (main+0x4dc0f0), and the framework's setInterval
+# (main+0x346c5c0) with +0x48, which sets the window's present interval (main+0xf49970) and the framework's fps (+0xfc = 60 / interval). So 30 fps (interval 2) is the game's
+# own mode, with its game time stepping by the interval. The stub at main+0x3b4f074 replaces the interval and fps with the host's step (state page +0x20, 1 = 60 fps, 2 = 30) while
+# a target fps is set (state +0x0, the launcher's Frame rate / DM_FPS_TARGET; 0 = the game's own choice), and counts the vsyncs stepped (+0x30) for the host's speed check
+def frame_step(ctx):
+    here, emit, fs_site, fs_put, FS_STATE_OFF = ctx.here, ctx.emit, ctx.site, ctx.put, ctx.state
+    site = 0x3b4f074
+    fs_site(site, 'e00314aa')   # mov x0,x20
+    start = here(); emit(ADRP(16, here(), FS_STATE_OFF))
+    for w in (0xb9400211,   # ldr w17,[x16]           target fps (float bits; 0 = off)
+              0x34000151,   # cbz w17,orig (+10)
+              0xb9402211,   # ldr w17,[x16,#0x20]     step in vsyncs
+              0x34000111,   # cbz w17,orig (+8)       not decided yet
+              0xb9004a91,   # str w17,[x20,#0x48]     the controller's interval
+              0x52800789,   # mov w9,#60
+              0x1ad10929,   # udiv w9,w9,w17
+              0xb9005a89,   # str w9,[x20,#0x58]      its fps, which setFrameRate takes
+              0xf9401a09,   # ldr x9,[x16,#0x30]
+              0x8b314129,   # add x9,x9,w17,uxtw
+              0xf9001a09,   # str x9,[x16,#0x30]      vsyncs stepped
+              0xaa1403e0):  # orig: mov x0,x20
+        emit(w)
+    emit(B(here(), site + 4))
+    fs_put(site, [B(site, start)], "frame step: the frame-rate controller's interval and fps follow the host's vsyncs (state page target fps; 0 = the game's own choice)")
+
+FRAME_STEP = {'e0f3ccfaf50065ae4ea01eb5aeb13b1a': frame_step}
+
+
+BINDING = [
+    {'what': 'movie player: decoded video without NDVE enhancement', 'now': 'build', 'goal': 'game', 'purpose': 'frame rate',
+     'why': 'a platform workaround: the translated tensor network dominates the iPhone movie frame',
+     'blocked': 'the tensor translation must become cheap enough before this workaround can be removed'},
+    {'what': 'frame controller: interval and fps follow the host step', 'now': 'build', 'goal': 'game', 'purpose': 'frame rate',
+     'why': 'the verified v131072 controller already supports whole-vsync intervals and steps game time by them',
+     'blocked': 'frame-step stubs have no function-matched form yet'},
+]
+
diff --git a/dm/gfx/tests/t_dispatch_overlap.m b/dm/gfx/tests/t_dispatch_overlap.m
new file mode 100644
index 0000000..ad0b650
--- /dev/null
+++ b/dm/gfx/tests/t_dispatch_overlap.m
@@ -0,0 +1,75 @@
+// A/B selection must actually alternate dispatch scheduling, while each real
+// game barrier, copy and host dispatch continues to order dependent GPU work.
+#define nvn_game_fps nvn_game_fps_mtl_default
+#include "../nvn/nvn_mtl.m"
+#undef nvn_game_fps
+uint64_t g_t0_ns;
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+
+static void encode(id<MTLComputePipelineState> ps, id<MTLBuffer> b, NSUInteger offset, int game) {
+    id<MTL4ComputeCommandEncoder> e = dispatch_enc(game);
+    enc_c_pso(e, ps); enc_c_args(e, b.gpuAddress + offset, 0);
+    enc_c_dispatch(e, MTLSizeMake(16, 1, 1), MTLSizeMake(64, 1, 1));
+}
+static void ordering(void) {
+    mtl_init();
+    NSError *error = nil;
+    id<MTLLibrary> lib = [g_dev newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal;\n"
+        "kernel void produce(device uint *p [[buffer(0)]], uint i [[thread_position_in_grid]]) { p[i] = i + 17; }\n"
+        "kernel void consume(device uint *p [[buffer(0)]], uint i [[thread_position_in_grid]]) { p[1024+i] = p[i] + 1; }\n"
+        options:nil error:&error];
+    CHECK(lib != nil, "GPU fixture compiles"); if (!lib) { fprintf(stderr, "%s\n", error.description.UTF8String); return; }
+    id<MTLComputePipelineState> producer = [g_dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"produce"] error:&error];
+    id<MTLComputePipelineState> consumer = [g_dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"consume"] error:&error];
+    id<MTLBuffer> b = [g_dev newBufferWithLength:16384 options:MTLResourceStorageModeShared];
+    CHECK(producer && consumer && b, "GPU fixture pipelines and memory exist"); if (!producer || !consumer || !b) return;
+    res_add(b);
+    for (long phase = 0; phase < 2; phase++) {
+        atomic_store(&g_ab_phase, phase); memset(b.contents, 0, b.length);
+        mtl_sub_begin();
+        encode(producer, b, 0, 1);
+        uint64_t barriers = mtl_blit_barriers();
+        encode(producer, b, 8192, 1);
+        CHECK(mtl_blit_barriers() - barriers == (phase ? 0 : 1), "only enabled overlap removes the independent dispatch barrier");
+        // Exercise the actual game's barrier command before a dependent reader.
+        struct { op_hdr barrier; uint32_t bits, pad; op_hdr end; } commands = {
+            {OP_BARRIER, 16}, NVN_BARRIER_ORDER_PRIMITIVES_BIT, 0, {OP_END, 8}};
+        mtl_exec((const uint8_t *)&commands);
+        barriers = mtl_blit_barriers(); encode(consumer, b, 0, 1);
+        CHECK(mtl_blit_barriers() == barriers + 1, "a game barrier orders the dependent dispatch in both phases");
+        barriers = mtl_blit_barriers(); encode(consumer, b, 8192, 0);
+        CHECK(mtl_blit_barriers() == barriers + 1, "a host dispatch waits for earlier game dispatches");
+        barriers = mtl_blit_barriers(); encode(producer, b, 8192, 1);
+        CHECK(mtl_blit_barriers() == barriers + 1, "a game dispatch waits for a preceding host dispatch");
+        barriers = mtl_blit_barriers();
+        enc_b_copy_buffer(blit_buf(b.gpuAddress + 4096, b.gpuAddress + 8192, b.gpuAddress + 12288, b.gpuAddress + 16384), b, 4096, b, 12288, 4096);
+        CHECK(mtl_blit_barriers() == barriers + 1, "a copy waits for all preceding dispatch writes");
+        CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull), "GPU work completes");
+        CHECK(!mtl_last_commit_error(), "GPU work has no execution error");
+        int correct = 1; const uint32_t *words = b.contents;
+        for (unsigned i = 0; i < 1024; i++) correct &= words[1024 + i] == i + 18 && words[3072 + i] == i + 18;
+        CHECK(correct, "dependent dispatch and copy read the producer's results");
+    }
+    res_remove(b);
+}
+
+int main(void) { @autoreleasepool {
+    setenv("DM_AB", "120", 1);
+    setenv("DM_NVN_DISPATCH_OVERLAP", "ab", 1);
+    for (long phase = 0; phase < 4; phase++) {
+        atomic_store(&g_ab_phase, phase);
+        CHECK(dispatch_overlap() == (phase & 1), "dispatch overlap follows the current A/B phase");
+    }
+    int reported = 0;
+    for (int i = 0; i < g_sw_n; i++) reported |= !strcmp(g_sw_name[i], "DM_NVN_DISPATCH_OVERLAP");
+    CHECK(reported, "A/B results identify the dispatch-overlap configuration");
+    ordering();
+    printf("t_dispatch_overlap: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
diff --git a/dm/gfx/tests/t_end_alias.m b/dm/gfx/tests/t_end_alias.m
new file mode 100644
index 0000000..c619fce
--- /dev/null
+++ b/dm/gfx/tests/t_end_alias.m
@@ -0,0 +1,47 @@
+// End barriers must not duplicate the expensive alias flush kept on consumer barriers.
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", label); } } while (0)
+
+static uint64_t command_bytes(id<MTLTexture> target, int production) {
+    // Allocators retain their high-water mark: each control needs fresh storage.
+    mtl_drain();
+    for (int i = 0; i < g_alloc_n; i++) g_alloc4[i] = nil;
+    g_alloc_n = 0; memset(g_alloc_fence, 0, sizeof g_alloc_fence);
+    mtl_sub_begin();
+    for (int i = 0; i < 600; i++) {
+        MTL4RenderPassDescriptor *d = [MTL4RenderPassDescriptor new];
+        d.colorAttachments[0].texture = target;
+        d.colorAttachments[0].loadAction = MTLLoadActionClear;
+        d.colorAttachments[0].storeAction = MTLStoreActionStore;
+        d.colorAttachments[0].clearColor = MTLClearColorMake(.25, .5, .75, 1);
+        id<MTL4RenderCommandEncoder> e = enc_r_begin(d);
+        if (production) enc_r_end(e);
+        else {
+            // Identical consumer barrier; only the producer's alias flush differs.
+            [e barrierAfterStages:MTLStageAll beforeQueueStages:MTLStageAll visibilityOptions:MTL4VisibilityOptionDevice];
+            [e endEncoding];
+        }
+    }
+    CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull), "render submission completes");
+    CHECK(!mtl_last_commit_error(), "render submission has no GPU error");
+    return g_alloc4[g_alloc_cur].allocatedSize;
+}
+int main(void) { @autoreleasepool {
+    setenv("DM_NVN_ENC_THREAD", "0", 1); mtl_init();
+    MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:8 height:8 mipmapped:NO];
+    d.usage = MTLTextureUsageRenderTarget;
+    id<MTLTexture> t = [g_dev newTextureWithDescriptor:d]; res_add(t);
+    atomic_fetch_add(&g_big_n, 1);
+    CHECK(resource_vis() & MTL4VisibilityOptionResourceAlias, "consumer barriers flush aliases");
+    uint64_t control = command_bytes(t, 0), production = command_bytes(t, 1);
+    printf("600 render passes: control %llu bytes, production %llu bytes\n", (unsigned long long)control, (unsigned long long)production);
+    CHECK(production <= control + (2 << 20), "end barriers do not inflate command memory beyond the device-only control");
+    atomic_fetch_sub(&g_big_n, 1); res_remove(t);
+    printf("t_end_alias: %d checks, %d failed\n", checks, failed); return failed != 0;
+} }
diff --git a/dm/gfx/tests/t_ixc_ahead.m b/dm/gfx/tests/t_ixc_ahead.m
new file mode 100644
index 0000000..9f9a539
--- /dev/null
+++ b/dm/gfx/tests/t_ixc_ahead.m
@@ -0,0 +1,100 @@
+// Indirect draws converted ahead (ixc_run): the look-ahead goes past a uniform update that writes no record it took, so a later indirect draw in the
+// same render pass finds its conversion and the pass stays whole (Ocarina of Time's grass: an update between each indirect mesh draw split 5 passes a
+// frame), and past an indirect mesh draw whose writes go to a storage buffer that holds no record (ixc_writes_spare). An update that writes a later draw's record still stops it: that draw is converted after the update and draws what the update wrote (its pass ends to land
+// the update first, ubd_hits)
+#import <Foundation/Foundation.h>
+#define nvn_game_fps nvn_game_fps_mtl_default
+#include "../nvn/nvn_mtl.m"
+#undef nvn_game_fps
+#define g_ft g_ft_hle
+#include "../nvn/hle_nvn.c"
+#undef g_ft
+uint64_t g_t0_ns;
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod;
+int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+
+enum { PIXELS = 8, QUADS = 7 };
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+static _Alignas(16) uint8_t storage[4096];
+
+// Two indirect quad draws with a uniform update between them. overlap: the update writes the second draw's count (4: the quad covers the target);
+// otherwise it writes elsewhere and the CPU gave the second record 4. The first record draws nothing. Returns the centre pixel's red
+static unsigned run(prog_t *pg, uint8_t *pool, uint8_t *update_pool, int overlap, uint64_t *splits) {
+    uint32_t *first = (uint32_t *)(pool + 256), *second = (uint32_t *)(pool + 512);   // {count, instances, first, base instance}
+    first[0] = 0; first[1] = 1; first[2] = 0; first[3] = 0;
+    second[0] = overlap ? 0 : 4; second[1] = 1; second[2] = 0; second[3] = 0;
+    uint32_t four = 4;
+    NVNcommandBuffer cb = {0};
+    CB(&cb)->cur = storage; CB(&cb)->end = storage + sizeof storage;
+    h_nvnCommandBufferBeginRecording(&cb);
+    h_nvnCommandBufferBindProgram(&cb, (const NVNprogram *)pg, 3);   // recorded, as a game binds it: a pass replayed from the stream (g_defer) takes it from there
+    h_nvnCommandBufferDrawArraysIndirect(&cb, (NVNdrawPrimitive)QUADS, (uint64_t)(uintptr_t)first);
+    h_nvnCommandBufferUpdateUniformBuffer(&cb, (uint64_t)(uintptr_t)(update_pool + (overlap ? 512 : 1024)), sizeof four, 0, sizeof four, &four);
+    h_nvnCommandBufferDrawArraysIndirect(&cb, (NVNdrawPrimitive)QUADS, (uint64_t)(uintptr_t)second);
+    NVNcommandHandle handle = h_nvnCommandBufferEndRecording(&cb);
+
+    tex_t rt = {.magic = MAGIC('T', 'E', 'X', 0), .serial = nvn_new_serial()};
+    rt.d = (nvn_texdesc){.target = NVN_TEXTURE_TARGET_2D, .format = NVN_FORMAT_RGBA8, .width = PIXELS, .height = PIXELS, .depth = 1, .levels = 1, .samples = 1};
+    MTLTextureDescriptor *td = tex_desc(&rt, 0); td.storageMode = MTLStorageModeShared;
+    id<MTLTexture> out = [g_dev newTextureWithDescriptor:td]; res_add(out);
+    mtl_tex_init(&rt); serial_put(rt.serial, out);
+    uint8_t pixels[PIXELS * PIXELS * 4] = {0};
+    [out replaceRegion:MTLRegionMake2D(0, 0, PIXELS, PIXELS) mipmapLevel:0 withBytes:pixels bytesPerRow:PIXELS * 4];
+    state_reset(); memset(&R, 0, sizeof R);
+    mtl_sub_begin(); mtl_sub_index(&handle, 1);
+    R.has_rt = 1; R.rt.n = 1; R.rt.color[0] = &rt;
+    S.ds.dt = S.ds.dw = S.ds.st = 0; S.poly.cull = 0; S.color.blend_en = 0; S.chmask.mask = 0xffff;
+    uint64_t s0 = g_ixc_splits;
+    mtl_exec((const uint8_t *)(uintptr_t)handle);
+    CHECK(mtl_wait(mtl_sub_commit(), 10000000000ull) && !mtl_last_commit_error(), "the submission completes");
+    *splits = g_ixc_splits - s0;   // after the commit: a pass may be deferred and encoded there (g_defer)
+    [out getBytes:pixels bytesPerRow:PIXELS * 4 fromRegion:MTLRegionMake2D(0, 0, PIXELS, PIXELS) mipmapLevel:0];
+    mtl_tex_release(&rt);
+    return pixels[((PIXELS / 2) * PIXELS + PIXELS / 2) * 4];
+}
+
+int main(void) { @autoreleasepool {
+    mtl_init();
+    NSError *err = nil;
+    id<MTLLibrary> lib = [g_dev newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal;\n"
+                                                      "vertex float4 v(uint i [[vertex_id]]){const float2 p[4]={float2(-1,-1),float2(1,-1),float2(1,1),float2(-1,1)};return float4(p[i%4],0,1);}\n"
+                                                      "fragment float4 f(){return float4(1,0,0,1);}" options:nil error:&err];
+    if (!lib) { fprintf(stderr, "%s\n", err.localizedDescription.UTF8String); return 2; }
+    size_t bytes = 64 * 1024;
+    uint8_t *pool = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
+    if (pool == MAP_FAILED) return 2;
+    NVNmemoryPool physical; pool_builder_t builder = {.mem = pool, .size = bytes, .flags = 0x24};
+    if (!h_nvnMemoryPoolInitialize(&physical, (const NVNmemoryPoolBuilder *)&builder)) return 2;
+    NvProg *pr = [NvProg new];
+    pr->sh[0] = [NvShader new]; pr->sh[1] = [NvShader new];
+    pr->sh[0]->fn = [lib newFunctionWithName:@"v"]; pr->sh[1]->fn = [lib newFunctionWithName:@"f"];
+    pr->sh[1]->stage = 1; pr->sh[1]->rf.color_known = 1; pr->sh[1]->rf.color_mask = 1;
+    prog_t pg = {.serial = nvn_new_serial()};
+    serial_put(pg.serial, pr);   // NOLINT(clang-analyzer-osx.cocoa.RetainCount): g_by_serial holds pr until serial_del
+    uint64_t splits = 0;
+    unsigned red = run(&pg, pool, pool, 0, &splits);
+    CHECK(red == 255, "an update elsewhere: the second draw draws its record's 4 vertices");
+    CHECK(splits == 0, "an update elsewhere: the second draw was converted with the first, the pass is not split");
+    red = run(&pg, pool, pool, 1, &splits);
+    CHECK(red == 255, "an update of the second record: the second draw draws what the update wrote");
+    pool_t sparse = {0}; pool_builder_t virtual_builder = {.size=DM_GAME_APP_POOL + 2 * bytes, .flags=0x200};
+    CHECK(h_nvnMemoryPoolInitialize((NVNmemoryPool *)&sparse, (const NVNmemoryPoolBuilder *)&virtual_builder), "virtual argument pool initialized");
+    map_req mapping = {.phys=&physical, .size=bytes};
+    CHECK(h_nvnMemoryPoolMapVirtual((NVNmemoryPool *)&sparse, 1, (const NVNmappingRequest *)&mapping), "physical argument storage aliased into the virtual pool");
+    red = run(&pg, pool, sparse.mem, 1, &splits);
+    CHECK(red == 255, "a virtual update of a future physical record draws the updated count");
+    red = run(&pg, sparse.mem, pool, 1, &splits);
+    CHECK(red == 255, "a physical update of a future virtual record draws the updated count");
+    h_nvnMemoryPoolFinalize((NVNmemoryPool *)&sparse);
+    h_nvnMemoryPoolFinalize(&physical);
+    serial_del(pg.serial);
+    mtl_drain(); munmap(pool, bytes);
+    printf("t_ixc_ahead: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
+
diff --git a/dm/gfx/tests/t_shader_residency.m b/dm/gfx/tests/t_shader_residency.m
new file mode 100644
index 0000000..8986b73
--- /dev/null
+++ b/dm/gfx/tests/t_shader_residency.m
@@ -0,0 +1,35 @@
+// Shader keys read guest code on the CPU; hashing must not make it GPU resident.
+#define nvn_game_fps nvn_game_fps_mtl_default
+#include "../nvn/nvn_mtl.m"
+#undef nvn_game_fps
+#define g_ft g_ft_hle
+#include "../nvn/hle_nvn.c"
+#undef g_ft
+uint64_t g_t0_ns;
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", label); } } while (0)
+int main(void) { @autoreleasepool {
+    mtl_init(); size_t size = getpagesize();
+    void *mem = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
+    if (mem == MAP_FAILED) return 2;
+    memset(mem, 0xa5, size);
+    NVNmemoryPool pool = {0}; pool_builder_t builder = {.mem=mem, .size=size, .flags=0x24};
+    CHECK(h_nvnMemoryPoolInitialize(&pool, (const NVNmemoryPoolBuilder *)&builder), "code pool initialized");
+    int index = pool_find((uint64_t)mem, 16);
+    CHECK(index >= 0 && !g_pools[index].res, "CPU-only code pool begins nonresident");
+    uint8_t control[0x880] = {0}, direct[8], mapped[8]; uint32_t length = 16;
+    memcpy(control + 0x704, &length, 4);
+    NVNshaderData shader = {.data=(uint64_t)mem, .control=control};
+    CHECK(keys_hash(&shader, 0, direct), "direct shader key computed");
+    CHECK(keys_hash(&shader, 1, mapped) && !memcmp(direct, mapped, sizeof direct), "mapped shader key is unchanged");
+    CHECK(!g_pools[index].res, "hashing code does not make its pool GPU resident");
+    void *buffer; uint64_t offset;
+    CHECK(mtl_addr((uint64_t)mem, 16, &buffer, &offset) && g_pools[index].res, "an actual GPU binding still makes the pool resident");
+    h_nvnMemoryPoolFinalize(&pool); mtl_drain(); munmap(mem, size);
+    printf("t_shader_residency: %d checks, %d failed\n", checks, failed); return failed != 0;
+} }
diff --git a/dm/gfx/tests/test_dmsh_initialized.py b/dm/gfx/tests/test_dmsh_initialized.py
new file mode 100644
index 0000000..544eacc
--- /dev/null
+++ b/dm/gfx/tests/test_dmsh_initialized.py
@@ -0,0 +1,130 @@
+"""SPIR-V temporaries with a masked undefined value must not become MSL UB.
+
+The logical result is independent of the temporary on the path that does not
+store it. SPIR-V permits an undefined value there; reading an uninitialized
+MSL bool is undefined behavior in the target language instead.
+"""
+import ast
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+TOOLS = Path(__file__).resolve().parents[1] / 'tools'
+CROSS = TOOLS / 'spirv_cross_bin/spirv-cross'
+tree = ast.parse((TOOLS / 'dmsh_build.py').read_text())
+XC = next(ast.literal_eval(n.value) for n in tree.body if isinstance(n, ast.Assign)
+          and any(getattr(t, 'id', None) == 'XC' for t in n.targets))
+
+
+def masked_temporary_spv():
+    """out[i] = temp || odd(i); temp is stored only on the even path."""
+    ids = {}
+    def uid(name):
+        if name not in ids: ids[name] = len(ids) + 1
+        return ids[name]
+    def op(code, *words): return [(len(words) + 1) << 16 | code, *words]
+    def string(value):
+        data = value.encode() + b'\0'; data += bytes(-len(data) % 4)
+        return list(struct.unpack('<' + 'I' * (len(data) // 4), data))
+    w = op(17, 1) + op(14, 0, 1)  # Shader; Logical / GLSL450 memory model
+    w += op(15, 5, uid('main'), *string('main'), uid('gid'))
+    w += op(16, uid('main'), 17, 32, 1, 1)
+    w += op(71, uid('gid'), 11, 28)  # GlobalInvocationId
+    w += op(71, uid('array'), 6, 4) + op(71, uid('struct'), 2)
+    w += op(72, uid('struct'), 0, 35, 0)
+    w += op(71, uid('out'), 34, 0) + op(71, uid('out'), 33, 0)
+    w += op(19, uid('void')) + op(20, uid('bool')) + op(21, uid('uint'), 32, 0)
+    w += op(23, uid('uvec3'), uid('uint'), 3)
+    w += op(29, uid('array'), uid('uint')) + op(30, uid('struct'), uid('array'))
+    w += op(32, uid('pin'), 1, uid('uvec3')) + op(32, uid('pout'), 12, uid('struct'))
+    w += op(32, uid('pu'), 12, uid('uint')) + op(32, uid('pb'), 7, uid('bool'))
+    w += op(33, uid('fn'), uid('void'))
+    w += op(43, uid('uint'), uid('zero'), 0) + op(43, uid('uint'), uid('one'), 1)
+    w += op(59, uid('pin'), uid('gid'), 1) + op(59, uid('pout'), uid('out'), 12)
+    w += op(54, uid('void'), uid('main'), 0, uid('fn')) + op(248, uid('entry'))
+    w += op(59, uid('pb'), uid('slot'), 7)  # uninitialized function temporary
+    w += op(61, uid('uvec3'), uid('xyz'), uid('gid'))
+    w += op(81, uid('uint'), uid('lane'), uid('xyz'), 0)
+    w += op(199, uid('uint'), uid('bit'), uid('lane'), uid('one'))
+    w += op(170, uid('bool'), uid('even'), uid('bit'), uid('zero'))
+    w += op(247, uid('merge'), 0) + op(250, uid('even'), uid('yes'), uid('no'))
+    w += op(248, uid('yes')) + op(170, uid('bool'), uid('value'), uid('lane'), uid('zero'))
+    w += op(62, uid('slot'), uid('value')) + op(249, uid('merge'))
+    w += op(248, uid('no')) + op(249, uid('merge'))
+    w += op(248, uid('merge')) + op(61, uid('bool'), uid('temp'), uid('slot'))
+    w += op(168, uid('bool'), uid('odd'), uid('even'))
+    w += op(166, uid('bool'), uid('logical'), uid('temp'), uid('odd'))
+    w += op(169, uid('uint'), uid('result'), uid('logical'), uid('one'), uid('zero'))
+    w += op(65, uid('pu'), uid('ptr'), uid('out'), uid('zero'), uid('lane'))
+    w += op(62, uid('ptr'), uid('result')) + op(253) + op(56)
+    w = [0x07230203, 0x00010300, 0, len(ids) + 1, 0] + w
+    return struct.pack('<' + 'I' * len(w), *w)
+
+
+RUNNER = r'''
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <assert.h>
+int main(int argc, const char **argv) { @autoreleasepool {
+    assert(argc == 2); NSError *err = nil;
+    NSString *s = [NSString stringWithContentsOfFile:@(argv[1]) encoding:NSUTF8StringEncoding error:&err]; assert(s);
+    id<MTLDevice> d = MTLCreateSystemDefaultDevice(); assert(d);
+    id<MTLLibrary> lib = [d newLibraryWithSource:s options:nil error:&err];
+    if (!lib) { fprintf(stderr, "%s\n", err.description.UTF8String); return 1; }
+    id<MTLFunction> fn = [lib newFunctionWithName:@"main0"]; assert(fn);
+    id<MTLComputePipelineState> ps = [d newComputePipelineStateWithFunction:fn error:&err]; assert(ps);
+    enum { N = 4096, ROUNDS = 16 };
+    id<MTLBuffer> out = [d newBufferWithLength:N * sizeof(uint32_t) options:MTLResourceStorageModeShared];
+    id<MTLArgumentEncoder> args = [fn newArgumentEncoderWithBufferIndex:0];
+    id<MTLBuffer> ab = [d newBufferWithLength:args.encodedLength options:MTLResourceStorageModeShared];
+    [args setArgumentBuffer:ab offset:0]; [args setBuffer:out offset:0 atIndex:0];
+    id<MTLCommandQueue> q = [d newCommandQueue];
+    for (unsigned r = 0; r < ROUNDS; r++) {
+        memset(out.contents, 0xcc, out.length);
+        id<MTLCommandBuffer> cb = [q commandBuffer]; id<MTLComputeCommandEncoder> e = [cb computeCommandEncoder];
+        [e setComputePipelineState:ps]; [e setBuffer:ab offset:0 atIndex:0]; [e useResource:out usage:MTLResourceUsageWrite];
+        [e dispatchThreads:MTLSizeMake(N,1,1) threadsPerThreadgroup:MTLSizeMake(32,1,1)];
+        [e endEncoding]; [cb commit]; [cb waitUntilCompleted]; assert(cb.status == MTLCommandBufferStatusCompleted);
+        uint32_t *v = out.contents;
+        for (unsigned i = 0; i < N; i++) assert(v[i] == (uint32_t)(i == 0 || (i & 1)));
+    }
+    printf("masked temporary: %u results match the defined logical expression\n", N * ROUNDS);
+}}
+'''
+
+
+@unittest.skipUnless(sys.platform == 'darwin' and shutil.which('xcrun') and CROSS.exists(), 'needs Metal and spirv-cross')
+class InitializedTemporary(unittest.TestCase):
+    def translate(self, work):
+        spv, msl = work / 'masked.spv', work / 'masked.metal'
+        spv.write_bytes(masked_temporary_spv())
+        r = subprocess.run([str(CROSS), *XC, str(spv), '--output', str(msl)], capture_output=True, text=True)
+        self.assertEqual(r.returncode, 0, r.stderr)
+        return msl
+
+    def test_masked_temporary_has_no_uninitialized_reads(self):
+        with tempfile.TemporaryDirectory() as d:
+            msl = self.translate(Path(d))
+            r = subprocess.run(['xcrun', '-sdk', 'macosx', 'metal', '-fsyntax-only', '-O1',
+                                '-Werror=uninitialized', str(msl)], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0, r.stderr)
+
+    @unittest.skipUnless(os.environ.get('DMSH_TEST_GPU') == '1', 'set DMSH_TEST_GPU=1 for the Metal GPU test')
+    def test_defined_results_match_reference_on_gpu(self):
+        with tempfile.TemporaryDirectory() as d:
+            work = Path(d); msl = self.translate(work)
+            runner, exe = work / 'runner.m', work / 'runner'; runner.write_text(RUNNER)
+            r = subprocess.run(['xcrun', 'clang', '-fobjc-arc', '-O2', '-framework', 'Foundation',
+                                '-framework', 'Metal', str(runner), '-o', str(exe)], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            r = subprocess.run([str(exe), str(msl)], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
+            self.assertIn('65536 results match', r.stdout)
+
+
+if __name__ == '__main__': unittest.main()
